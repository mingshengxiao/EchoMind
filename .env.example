# Backend
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
MONGODB_URL=mongodb://localhost:27017
MONGODB_DATABASE=echomind
JWT_SECRET=change-me-in-production
CORS_ORIGINS=http://localhost:3000
MAX_UPLOAD_MB=10

# Frontend
# In production (same-domain deployment), leave this empty or unset.
# The frontend will automatically use relative URLs (same-origin requests).
# For local development, set to http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- Vercel Deployment Notes ---
# All backend env vars above must be set in Vercel project settings:
#   Settings → Environment Variables
# NEXT_PUBLIC_API_BASE_URL should be left empty/unset for production
# so the frontend uses same-origin requests (frontend & backend share one domain).
#
# MongoDB Atlas connection string should be used for MONGODB_URL in production.
# Backend
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
MONGODB_URL=mongodb://localhost:27017
MONGODB_DATABASE=echomind
JWT_SECRET=change-me-in-production
CORS_ORIGINS=http://localhost:3000
MAX_UPLOAD_MB=10

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
